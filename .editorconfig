# top-most EditorConfig file
root = true

[*]
insert_final_newline = true
indent_style = space
trim_trailing_whitespae = true

[*.{c,h,cpp,hpp}]
indent_size = 2

[*.{js,ts}]
indent_size = 2

[*.py]
indent_size = 4

[*.lua]
indent_size = 2

[*.{bash,sh,zsh}]
indent_size = 2

[*.{json,yml}]
indent_size = 2

[*.proto]
indent_size = 2

[BUILD]
indent_size = 4

[Makefile]
indent_style = tab

