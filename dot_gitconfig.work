[user]
    name = dhuang295
    email = dhuang295@bloomberg.net
[init]
    defaultBranch = main
[alias]
    upd = !git pull upstream $(git branch --show-current) && git push
    pm = !git sm && git upd
[core]
    fileMode = false
[credential]
    helper = osxkeychain
[url "bbgithub:"]
    insteadOf = https://bbgithub.dev.bloomberg.com/
[http]
    proxy = http://proxy.bloomberg.com:81
[https]
    proxy = http://proxy.bloomberg.com:81
[http "https://github.com"]
    proxy = http://proxy.bloomberg.com:81
    sslCAinfo = ~/bb-cert/bloomberg-root-ca.crt
[url "https://github.com/"]
    insteadOf = github.com:
[url "https://github.com/"]
    insteadOf = git@github.com:
[url "https://github.com/"]
    insteadOf = ssh://git@github.com/
