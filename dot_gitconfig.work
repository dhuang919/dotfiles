[user]
    name = dhuang295
    email = dhuang295@bloomberg.net
[init]
    defaultBranch = main
[alias]
    upd = !git pull upstream $(git remote show upstream | grep \"HEAD branch\" | sed 's/.*: //') && git push
    pm = !git sm && git upd && git rup
[core]
    fileMode = false
[url "bbgithub:"]
    insteadOf = https://bbgithub.dev.bloomberg.com/
[http]
    proxy = http://proxy.bloomberg.com:81
[https]
    proxy = http://proxy.bloomberg.com:81
