export DOCKER_DEFAULT_PLATFORM=linux/amd64
export GH_NO_UPDATE_NOTIFIER=1
export GOPRIVATE="*.dev.bloomberg.com"
export GOPROXY="https://goproxy.dev.bloomberg.com,direct"
export GOPATH="$HOME/go"
[[ $PATH != *${GOPATH}/bin* ]] && PATH="${PATH}:${GOPATH}/bin"
[[ $PATH != *${HOME}/Projects/bde/bde-tools/bin* ]] && PATH="${PATH}:${HOME}/Projects/bde/bde-tools/bin"
export PIPENV_PYPI_MIRROR=https://artprod.dev.bloomberg.com/artifactory/api/pypi/bloomberg-pypi/simple
export https_proxy="http://127.0.0.1:8888"
export HTTPS_PROXY="$https_proxy"
export http_proxy="$https_proxy"
export HTTP_PROXY="$https_proxy"

BBID=31453293
PIPDIR="${HOME}/.config/pip"

function tglpxy {
  local pipconf="${PIPDIR}/pip.conf"
  local npm="${HOME}/.npmrc"

  if [ -f "${pipconf}" ]; then
    echo "Renaming ${PIPDIR}/pip.conf to ${PIPDIR}/_pip.conf"
    mv $PIPDIR/{,_}pip.conf
  else
    echo "Renaming ${PIPDIR}/_pip.conf to ${PIPDIR}/pip.conf"
    mv $PIPDIR/{_,}pip.conf
  fi

  if [ -f "$npm" ]; then
    echo "Renaming ${HOME}/.npmrc to ${HOME}._npmrc"
    mv ~/.{,_}npmrc
  else
    echo "Renaming ${HOME}/._npmrc to ${HOME}/.npmrc"
    mv ~/.{_,}npmrc
  fi
}

function pipconf {
  if [ -z "${1}" ]; then
    echo "'dev' or 'prod' required" >&2
    return 1
  fi
  cp "${PIPDIR}/${1}.conf" "${PIPDIR}/pip.conf"
  echo "${1}.conf copied"
}

function bbid {
  echo -n $BBID | pbcopy
  echo "Copied $BBID to clipboard"
}

# Convert a bb mnemonic to a formatted url and copy to clipboard
# Usage: bbmd [-w|-j|-u] <mnemonic>
#   -w  blinks url in markdown format
#   -j  blinks url in Jira markdown format
#   -u  blinks url only
#   Default: bbg url in markdown format
function bbmd {
  local OPTIND mode="bbg"
  while getopts "wju" opt; do
    case $opt in
      w) mode="web" ;;
      j) mode="jira" ;;
      u) mode="url" ;;
      *) return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  if [[ -z "$1" ]]; then
    echo "Usage: bbmd [-w|-j|-u] <mnemonic>" >&2
    return 1
  fi

  # Strip {, }, <GO> and trim whitespace
  local m
  m="$(echo "$1" | sed 's/[{}]//g; s/<GO>//g' | xargs)"

  # URL encode spaces
  local e="${m// /%20}"

  local res
  case $mode in
    web) res="[${m}](https://blinks.bloomberg.com/screens/${e})" ;;
    jira) res="[${m}|https://blinks.bloomberg.com/screens/${e}]" ;;
    url) res="https://blinks.bloomberg.com/screens/${e}" ;;
    bbg) res="[${m}](bbg://screens/${e})" ;;
  esac

  printf '%s' "$res" | pbcopy
  echo "Copied to clipboard: $res"
}

source ~/.lcldevrc
ssh-add ~/.ssh/bbgithub/id_ed25519

alias dpxy='http_proxy=http://bproxy.tdmz1.bloomberg.com:80 https_proxy=http://bproxy.tdmz1.bloomberg.com:80 no_proxy=dev.bcs.bloomberg.com'
alias epxy='http_proxy=http://proxy.bloomberg.com:81 https_proxy=http://proxy.bloomberg.com:81 no_proxy=dev.bcs.bloomberg.com'
alias r3t='docker run --rm -v "$(pwd -P):/workarea" -e USER=${USER} -it artprod.dev.bloomberg.com/training/rapi3tool:latest bash'
alias cc='curl -fsSL "https://cc-setup.s3.dev.bcs.bloomberg.com/cc-setup.sh" -o /tmp/cc-setup.sh && chmod +x /tmp/cc-setup.sh && /tmp/cc-setup.sh'
