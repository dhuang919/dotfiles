alias dpxy='http_proxy=http://bproxy.tdmz1.bloomberg.com:80 https_proxy=http://bproxy.tdmz1.bloomberg.com:80'
alias epxy='http_proxy=http://proxy.bloomberg.com:81 https_proxy=http://proxy.bloomberg.com:81'
alias mbs="curl --noproxy '*' -s \"https://lcldev-public.dx.bloomberg.com/mac-$(uname -p)-bootstrap\" -o /tmp/bootstrap && chmod +x /tmp/bootstrap && /tmp/bootstrap"
alias scripts='cd ~/Projects/dhuang295/scripts'
alias ts='cd ~/Projects/tssr'

export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm

function tglpxy {
  local pipconf="${PIPDIR}/pip.conf"
  local npm="${HOME}/.npmrc"

  if [ -f "${pipconf}" ]; then
    echo "Renaming ${PIPDIR}/pip.conf to ${PIPDIR}/_pip.conf"
    mv $PIPDIR/{,_}pip.conf
  else
    echo "Renaming ${PIPDIR}/_pip.conf to ${PIPDIR}/pip.conf"
    mv $PIPDIR/{_,}pip.conf
  fi

  if [ -f "$npm" ]; then
    echo "Renaming ${HOME}/.npmrc to ${HOME}._npmrc"
    mv ~/.{,_}npmrc
  else
    echo "Renaming ${HOME}/._npmrc to ${HOME}/.npmrc"
    mv ~/.{_,}npmrc
  fi
}

function bbid {
  echo -n $BBID | pbcopy
}

function pipconf {
  if [ -z "${1}" ]; then
    echo "'dev' or 'prod' required" >&2
    return 1
  fi
  cp "${PIPDIR}/${1}.conf" "${PIPDIR}/pip.conf"
  echo "${1}.conf copied"
}

function cpnvim {
  if [[ -z "${1}" ]]; then
    echo "Host required" >&2
    return 1
  fi
  # Copy nvim configs to dev
  scp -r ~/.config/nvim "${1}:/home/dhuang295/.config/"
}

source ~/.lcldevrc
{{- end }}
