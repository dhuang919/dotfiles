function tglpxy {
  local pip="~/.pip/pip.conf"
  local npm="~/.npmrc"

  if [ -f "$pip" ]; then
    echo "Renaming pip.conf"
    mv ~/.pip/{,_}pip.conf
  else
    echo "Reverting _pip.conf rename"
    mv ~/.pip/{_,}pip.conf
  fi

  if [ -f "$npm" ]; then
    echo "Renaming .npmrc to ._npmrc"
    mv ~/.{,_}npmrc
  else
    echo "Reverting ._npmrc rename"
    mv ~/.{_,}npmrc
  fi
}
