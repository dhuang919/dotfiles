[user]
    name = Derek Huang
    email = derekh919@gmail.com
[branch]
    autosetupmerge = true
[diff]
    tool = difftastic
    mnemonicprefix = true
    algorithm = patience
[color]
    ui = auto
[core]
    editor = vim
    autocrlf = false
    safecrlf = true
    pager = diff-so-fancy | less --tabs=2 -RFX
    sshCommand = "ssh -F ~/.ssh/personal.config"
[push]
    default = origin
    autoSetupRemote = true
[pull]
    rebase = false
[alias]
    alias = config --get-regexp ^alias\\.
    br = branch
    ci = commit
    co = checkout
    hist = log --pretty=format:'%C(bold blue)%h%C(reset) %C(bold cyan)%ad%C(reset) | %C(bold green)%s%C(reset)%C(bold yellow)%d%C(reset) [%C(white)%an%C(reset)]' --graph --date=short
    prul = !git pull && git remote update origin --prune
    pu = !git push -u origin $(git rev-parse --abbrev-ref HEAD)
    re = restore
    rup = remote update origin --prune
    sm = !git switch $(git remote show upstream | grep \"HEAD branch\" | sed 's/.*: //')
    st = status
    sta = stash
    stp = stash pop
    sw = switch
    gone = "!f() { git fetch --all --prune; git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D; }; f"
    fza = "!git ls-files -m -o --exclude-standard | fzf -m --print0 | xargs -0 git add"
[merge]
    conflictstyle = zdiff3
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[credential]
    helper = store
[include]
    path = .gitconfig.work
[submodule]
    recurse = true
