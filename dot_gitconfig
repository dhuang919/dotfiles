[user]
	name = Derek Huang
	email = derekh919@gmail.com
[color]
	ui = auto
[core]
	editor = vim
	autocrlf = false
	safecrlf = true
	pager = diff-so-fancy | less --tabs=2 -RFX
[push]
	default = upstream
[pull]
  rebase = false
[alias]
	ci = commit
	st = status
	br = branch
	co = checkout
	cm = checkout master
  pu = !git push -u origin $(git rev-parse --abbrev-ref HEAD)
  pum = !git pull origin master
	sta = stash
	stp = stash pop
	prul = !git pull && git remote update origin --prune
	alias = config --get-regexp ^alias\\.
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
[merge]
	tool = opendiff
	conflictstyle = diff3
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = store

