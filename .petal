export LDFLAGS="-L/usr/local/opt/zlib/lib"
export CPPFLAGS="-I/usr/local/opt/zlib/include"
export PKG_CONFIG_PATH="/usr/local/opt/zlib/lib/pkgconfig"

export GITHUB_API_TOKEN=***REMOVED_GITHUB_PAT***
export JIRA_API_TOKEN=***REMOVED_JIRA***
export JIRA_USER_EMAIL="derek.huang@petalcard.com"
export JIRA_PROJECT_KEY=RE
export JIRA_SAMPLE_ISSUE=RE-1991
export PAGERDUTY_TOKEN="***REMOVED_PAGERDUTY***"
export PT_USER=derek
export PT_ROOT=~/dev/shared
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

alias v_staging_login="vt staging login -method=okta username=derek.huang@petalcard.com"
alias v_prod_login="vt production login -method=okta username=derek.huang@petalcard.com"

function vt {
  local env=${1:-staging}
  shift
  VAULT_ADDR="https://vault.$env.petalcard.com" vault "$@"
}

function get_db_iam_token {
  local env=${1:-staging}
  local SERVICE_NAME=decision_engine
  TOKEN=$(\
    AWS_SECRET_ACCESS_KEY=$(vt "$env" kv get -field=secret_access_key secret/${SERVICE_NAME}/postgres/aws) \
    AWS_ACCESS_KEY_ID=$(vt "$env" kv get -field=access_key_id secret/${SERVICE_NAME}/postgres/aws) \
    aws rds generate-db-auth-token --hostname $(vt "$env" kv get -field=value secret/${SERVICE_NAME}/postgres/host) \
    --port $(vt "$env" kv get -field=value secret/${SERVICE_NAME}/postgres/port) \
    --region $(vt "$env" kv get -field=value secret/${SERVICE_NAME}/postgres/aws_region) \
    --username $(vt "$env" kv get -field=value secret/${SERVICE_NAME}/postgres/username) \
  )
  echo "psql \"host=decision-engine-database1-$env.cqrfni06lp1e.us-east-1.rds.amazonaws.com dbname=decision_engine user=decision_engine password=$TOKEN\""
}

function pta {
  local cur=$(basename "$PWD")
  local pt_dir=${1:-$cur}
  source ${PT_ROOT}/${pt_dir}/venv/bin/activate
}

alias pt=/Users/derek.huang/dev/shared/pt/venv/bin/pt
alias oncalls=~/dev/sandbox/py/get_pagerduty_oncalls

