[[ $PATH != *$HOME/.local/bin* ]] && PATH="${PATH}:${HOME}/.local/bin"
[[ $PATH != *"${HOME}/.npm-global/bin"* ]] && PATH="${PATH}:${HOME}/.npm-global/bin"
[[ $PATH != */usr/local/go/bin* ]] && PATH="${PATH}:/usr/local/go/bin"
[[ $PATH != *$GOPATH* ]] && PATH="${PATH}:${GOPATH}bin"
[[ $PATH != *$HOME/.yarn/bin* ]] && PATH="${PATH}:${HOME}/.yarn/bin"
[[ $PATH != *$BIO_ROOT/beeswax/buzz_api/buzz/vendor/bin* ]] && PATH="${PATH}:${BIO_ROOT}/beeswax/buzz_api/buzz/vendor/bin"
[[ $PATH != *$BIO_ROOT/beeswax/bw/bin* ]] && PATH="${PATH}:${BIO_ROOT}/beeswax/bw/bin"
export PATH
export ZSH="$HOME/.oh-my-zsh"
export EDITOR=vim
export HISTTIMEFORMAT="%d/%m/%y %T "
export NVM_DIR="$HOME/.nvm"
export FZF_DIR="$HOME/.fzf"
export GPG_TTY=$(tty)

export BIO_ROOT="${HOME}/beeswaxio"
export BW_USER=derek
export GOPATH="${HOME}/go/"


function convert_app_name {
  local app=${1}
  case $app in
    as | aster ) app=aster ;;
    bk | beekeeper ) app=beekeeper ;;
    ns | nest ) app=nest ;;
    hc | honeycrisp ) app=honeycrisp ;;
    st | stats ) app=stats ;;
  esac
  echo $app
}

function cucu {
  xvfb-run -a bundle exec cucumber "$@"
}

function next {
  local app=$(convert_app_name $1)
  cd "${BIO_ROOT}/beeswax/buzz_next/$app"
}

function migrate_log {
  local app=$(convert_app_name $1)
  local flag=${3:--l}
  if [[ ${flag} == "-t" ]]; then
    tail -f -n 100 "/var/log/beeswax/buzz-next/$app/$2.log"
  else
    less +G "/var/log/beeswax/buzz-next/$app/$2.log"
  fi
}

function migrate {
  local app=$(convert_app_name $1)
  shift || true
  buzz_tool $app migrate "$@"
}

function buzz_test {
  if [[ "$1" == "-d" ]]; then
    shift
    bazel run //beeswax/buzz_api/test:run_tests -- "$@"
  else
    sudo phpdismod xdebug
    bazel run //beeswax/buzz_api/test:run_tests -- "$@"
    sudo phpenmod xdebug
  fi
}

[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
zstyle ':completion:*' special-dirs true
zstyle ':completion:*:*:git:*' script ~/.zsh/completion/git-completion.bash

ZSH_THEME=powerlevel10k/powerlevel10k

plugins=(fzf git sudo)

fpath=(/usr/local/bin/bazel ~/.zsh/completion/ $fpath)

if type brew &>/dev/null; then
  fpath+=$(brew --prefix)/share/zsh/site-functions
fi

source $ZSH/oh-my-zsh.sh
autoload -Uz compinit && compinit
autoload bashcompinit && bashcompinit
zmodload -i zsh/complist

[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

alias api="${BIO_ROOT}/beeswax/buzz_api"
alias cdb="${BIO_ROOT}"
alias compile_messages="${BIO_ROOT}/beeswax/buzz_api/tools/compile_messages.py && sudo service php7.4-fpm restart"
alias fes="${BIO_ROOT}/beeswax/buzz_fes_ui"
alias htop="sudo htop"
alias ipy=ipython
alias ll="ls -lahF"
alias ppl="${BIO_ROOT}/beeswax/people/dhuang"
alias setup_vm="$BIO_ROOT/beeswax/setup/dev/setup_vm.sh"
alias sql="mysql -uroot -proot dev_buzz_db"
alias startas="buzz_tool aster manage runserver 0.0.0.0:7000"
alias startbk="buzz_tool beekeeper manage runserver 0.0.0.0:7050"
alias startui="cd ${BIO_ROOT}/beeswax/buzz_ui && yarn run dev"
alias ui="${BIO_ROOT}/beeswax/buzz_ui"

eval $(thefuck --alias)

source $HOME/.pvars
