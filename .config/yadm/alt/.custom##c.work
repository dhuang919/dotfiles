export LDFLAGS="-L/usr/local/opt/zlib/lib"
export CPPFLAGS="-I/usr/local/opt/zlib/include"
export PKG_CONFIG_PATH="/usr/local/opt/zlib/lib/pkgconfig"
export PATH="/usr/local/opt/findutils/libexec/gnubin:/usr/local/opt/coreutils/libexec/gnubin:$PATH"

export AWS_ACCESS_KEY_ID=***REMOVED_AWS_KEY_ID***
export AWS_SECRET_ACCESS_KEY=***REMOVED_AWS_SECRET***
export AWS_PROFILE=default
export AWS_REGION=us-east-1

export GITHUB_API_TOKEN=***REMOVED_GITHUB_PAT***
export JIRA_API_TOKEN=***REMOVED_JIRA***
export JIRA_USER_EMAIL="derek.huang@petalcard.com"
export JIRA_PROJECT_KEY=RE
export JIRA_SAMPLE_ISSUE=RE-1991
export PT_USER=derek
export PT_ROOT=~/dev/shared

alias vlogin="vt login -method=okta username=derek.huang@petalcard.com"

function vt() {
  VAULT_ADDR=https://vault.production.petalcard.com vault "$@"
}

function pta() {
  local cur=$(basename "$PWD")
  local pt_dir=${1:-$cur}
  source ${PT_ROOT}/${pt_dir}/venv/bin/activate
}

