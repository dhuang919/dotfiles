export LDFLAGS="-L/usr/local/opt/zlib/lib"
export CPPFLAGS="-I/usr/local/opt/zlib/include"
export PKG_CONFIG_PATH="/usr/local/opt/zlib/lib/pkgconfig"
export PATH="/usr/local/opt/findutils/libexec/gnubin:/usr/local/opt/coreutils/libexec/gnubin:$PATH"
export AWS_ACCESS_KEY_ID=***REMOVED_AWS_KEY_ID***
export AWS_SECRET_ACCESS_KEY=***REMOVED_AWS_SECRET***
export AWS_PROFILE=default
export AWS_REGION=us-east-1
export VAULT_ADDR=https://vault.production.petalcard.com

