[[ $PATH != */Users/derek/Library/Python/3.8/bin* ]] && PATH="${PATH}:/Users/derek/Library/Python/3.8/bin"
[[ $PATH != *$HOME/.local/bin* ]] && PATH="${PATH}:${HOME}/.local/bin"
[[ $PATH != *$HOME/.poetry/bin* ]] && PATH="${PATH}:${HOME}/.poetry/bin"
export PATH

export PYTHONDONTWRITEBYTECODE=1
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl@1.1)"
export ZSH="$HOME/.oh-my-zsh"
export EDITOR=vim
export HISTTIMEFORMAT="%d/%m/%y %T "
export NVM_DIR="$HOME/.nvm"
export FZF_DIR="$HOME/.fzf"
export GPG_TTY=$(tty)
export YADM="$HOME/.config/yadm"

function _get_last_md {
  echo $(ls -l "${1}" | grep .md | awk '{print $NF}' | sort -rn | head -n 1)
}

function get_lc_times {
  ag --nofilename -i 'leetcode' ~/Dropbox/notes/scratch | \
  grep -E '[0-9]{4} - [0-9]{4}' | \
  tr -d '* leetcode ' | \
  tr , '\n' | \
  sed -E 's/([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})/("\1:\2", "\3:\4")/'
}

function morning {
  local -r scratch_path="${HOME}/Dropbox/notes/scratch"
  local -r year_month=$(date +%Y_%m)
  local -r today=$(date +%d_%a | tr '[:upper:]' '[:lower:]')
  local -r today_path="${scratch_path}/${year_month}/${today}.md"

  if [[ -f "${today_path}" ]]
  then
    echo "${today_path} already exists" >&2
    return 1
  fi

  # Make sure the current year month dir exists
  mkdir -p "${scratch_path}/${year_month}"

  # Get the most recent md before today
  local prev_md=$(_get_last_md "${scratch_path}/${year_month}")

  local prev_dir
  # If the prev md is empty, today is the first of the month
  if [[ -z "${prev_md}" ]]
  then
    prev_dir=$(date -v -1m +%Y_%m)
    prev_md=$(_get_last_md "${scratch_path}/${prev_dir}")
  else
    prev_dir="${year_month}"
  fi

  local -r unfinished_todos=$(sed -ne '/- \[ \] [\w]*/p' "${scratch_path}/${prev_dir}/${prev_md}")

  cat << EOF >> ${today_path}
# Todo
$unfinished_todos

# Notes
* leetcode
* 

# Decisions
* 
EOF
}

function ww {
  open /Applications/Slack.app
  open /Applications/Spotify.app
  open /Applications/Obsidian.app
  open /System/Applications/Mail.app
  morning
}

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
zstyle ':completion:*' special-dirs true
zstyle ':completion:*:*:git:*' script ~/.zsh/completion/git-completion.bash

ZSH_THEME=powerlevel10k/powerlevel10k

plugins=(fzf git)

fpath=(~/.zsh/completion $fpath)

if type brew &>/dev/null; then
  fpath+=$(brew --prefix)/share/zsh/site-functions
fi

source $ZSH/oh-my-zsh.sh
autoload -Uz compinit && compinit
autoload bashcompinit && bashcompinit
zmodload -i zsh/complist

[ -f ~/.p10k.zsh ] && source ~/.p10k.zsh
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f ~/.custom ] && source ~/.custom 2>& /dev/null

[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
[ -s /usr/local/opt/nvm/nvm.sh ] && \. /usr/local/opt/nvm/nvm.sh
[ -s /usr/local/opt/nvm/etc/bash_completion.d/nvm ] && \. /usr/local/opt/nvm/etc/bash_completion.d/nvm

alias htop="sudo htop"
alias ll="ls -lahF"
alias ipy=ipython
alias bubu="brew update && brew upgrade && brew cleanup"
alias setup="cd ~/dev/setup"

alias sbx="cd ${HOME}/dev/sandbox"
alias sbxc="code ${HOME}/dev/sandbox"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

