[[ $PATH != */usr/local/opt/findutils/libexec/gnubin* ]] && PATH="${PATH}:/usr/local/opt/findutils/libexec/gnubin"
[[ $PATH != */usr/local/opt/coreutils/libexec/gnubin* ]] && PATH="${PATH}:/usr/local/opt/coreutils/libexec/gnubin"
[[ $PATH != */usr/local/texlive/2022basic/bin/universal-darwin* ]] && PATH="${PATH}:/usr/local/texlive/2022basic/bin/universal-darwin"
export PATH

export PYTHONDONTWRITEBYTECODE=1
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$(brew --prefix openssl@1.1)"
export ZSH="$HOME/.oh-my-zsh"
export EDITOR=vim
export HISTTIMEFORMAT="%d/%m/%y %T "
export NVM_DIR="$HOME/.nvm"
export FZF_DIR="$HOME/.fzf"
export GPG_TTY=$(tty)
export YADM="$HOME/.config/yadm"
export SCR="$HOME/Library/CloudStorage/Dropbox/notes/scratch/"


function fmt_img {
  convert "$1" "$2"
  convert -resize 30% "$2" "$2"
}

function _get_last_md {
  echo $(ls -l "${1}" | grep .md | awk '{print $NF}' | sort -rn | head -n 1)
}

function get_lc_times {
  ag --nofilename -i 'leetcode' ~/Dropbox/notes/scratch | \
  grep -E '[0-9]{4} - [0-9]{4}' | \
  tr -d '* leetcode ' | \
  tr , '\n' | \
  sed -E 's/([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})/("\1:\2", "\3:\4")/'
}

function man {
  env \
  LESS_TERMCAP_mb="$(printf "\e[1;31m")" \
  LESS_TERMCAP_md="$(printf "\e[1;31m")" \
  LESS_TERMCAP_me="$(printf "\e[0m")" \
  LESS_TERMCAP_se="$(printf "\e[0m")" \
  LESS_TERMCAP_so="$(printf "\e[1;44;33m")" \
  LESS_TERMCAP_ue="$(printf "\e[0m")" \
  LESS_TERMCAP_us="$(printf "\e[1;32m")" \
  man "${@}"
}

function morning {
  local -r year_month=$(/usr/local/opt/coreutils/libexec/gnubin/date +%Y_%m)
  local -r today=$(/usr/local/opt/coreutils/libexec/gnubin/date +%d_%a | tr '[:upper:]' '[:lower:]')
  local -r today_path="${SCR}/${year_month}/${today}.md"

  if [[ -f "${today_path}" ]]
  then
    echo "${today_path} already exists" >&2
    return 1
  fi

  # Make sure the current year month dir exists
  mkdir -p "${SCR}/${year_month}"

  # Get the most recent md before today
  local prev_md=$(_get_last_md "${SCR}/${year_month}")

  local prev_dir
  if [[ -z "${prev_md}" ]]
  then
    # ensure we get the last md if it's been longer than a month since the last
    while [[ -z "${prev_md}" ]]
    do
      prev_dir=$(/usr/local/opt/coreutils/libexec/gnubin/date -d "1 month ago" +%Y_%m)
      prev_md=$(_get_last_md "${SCR}/${prev_dir}")
    done
  else
    prev_dir="${year_month}"
  fi

  local -r unfinished_todos=$(sed -E -ne '/(- \[ \] [\w]*|#do_it|#schedule_it|#delegate_it|#delete_it)/p' "${SCR}/${prev_dir}/${prev_md}")

  cat << EOF >> ${today_path}
# Todo
$unfinished_todos

# Notes
EOF
}

function tp {
  if ! type blueutil &> /dev/null
  then
    echo "blueutil not installed" >&2
    return 1
  fi
  blueutil --unpair a0-78-17-e3-31-79
  blueutil --connect a0-78-17-e3-31-79
}

function ww {
  open /Applications/Obsidian.app
  open /System/Applications/Calendar.app
  open /Applications/Bitwarden.app
  open /Applications/Docker.app
  morning
}

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
zstyle ':completion:*' special-dirs true
zstyle ':completion:*:*:git:*' script ~/.zsh/completion/git-completion.bash

ZSH_THEME=powerlevel10k/powerlevel10k

plugins=(fzf git)

fpath=(~/.zsh/completion $fpath)

if type brew &>/dev/null; then
  fpath+=$(brew --prefix)/share/zsh/site-functions
fi

source $ZSH/oh-my-zsh.sh
autoload -Uz compinit && compinit -i
autoload bashcompinit && bashcompinit
zmodload -i zsh/complist

[ -f ~/.p10k.zsh ] && source ~/.p10k.zsh
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f ~/.custom ] && source ~/.custom 2>& /dev/null

alias htop="sudo htop"
alias ll="ls -lAh"
alias ipy=ipython
alias bubu="brew update && brew upgrade && brew cleanup"
alias lct="get_lc_times | python ~/dev/sandbox/py/sum_timestamps.py"
alias setup="cd ~/dev/setup"
alias sbx="cd ${HOME}/dev/sandbox"
alias sbxc="code ${HOME}/dev/sandbox"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
