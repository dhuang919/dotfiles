[branch]
      autosetupmerge = true
      sort = -committerdate
[tag]
      sort = version:refname
[core]
      autocrlf = false
      editor = nvim
      pager = delta
[init]
      defaultBranch = main
[diff]
      algorithm = histogram
      colorMoved = plain
      mnemonicPrefix = true
      renames = true
[delta]
      line-numbers = true
      navigate = true
      true-color = always
      light = true
[interactive]
      diffFilter = delta --color-only
[push]
      default = simple
      autoSetupRemote = true
      followTags = true
[fetch]
      prune = true
      pruneTags = true
[pull]
      ff = only
[transfer]
      fsckObjects = true
[submodule]
      recurse = true
[alias]
      alias = config --get-regexp ^alias\\.
      br = branch
      ci = commit
      co = checkout
      gone = "!f() { git fetch --all --prune; git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D; }; f"
      hist = log --pretty=format:'%C(bold blue)%h%C(reset) %C(bold cyan)%ad%C(reset) | %C(bold green)%s%C(reset)%C(bold yellow)%d%C(reset) [%C(white)%an%C(reset)]' --graph --date=short
      re = restore
      st = status -sb
      sta = stash
      stp = stash pop
      sw = switch
